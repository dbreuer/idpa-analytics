  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Square ink button for an emphasized action, with red hover and keyboard focus.",
      "html": "<button class=\"ds-primary-button\" type=\"button\">Open results</button>",
      "css": ".ds-primary-button{display:inline-flex;align-items:center;justify-content:center;padding:8px 16px;border:1px solid var(--ink);border-radius:0;background:var(--ink);color:var(--paper);font:600 0.875rem 'DM Sans',sans-serif;transition:background-color 150ms ease}.ds-primary-button:hover{background:var(--signal-dark)}.ds-primary-button:focus-visible{outline:2px solid var(--signal);outline-offset:3px}.ds-primary-button:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "Filter Select",
      "kind": "input",
      "refersTo": "filter-control",
      "description": "Labeled compact selector with warm paper fill and visible red focus.",
      "html": "<label class=\"ds-filter-label\" for=\"season-filter\">Division</label><select id=\"season-filter\" class=\"ds-filter-control\"><option>All divisions</option></select>",
      "css": ".ds-filter-label{display:block;color:var(--ink-muted);font:700 0.67rem 'DM Sans',sans-serif;letter-spacing:.14em;text-transform:uppercase}.ds-filter-control{display:block;width:100%;margin-top:6px;padding:8px 12px;border:1px solid var(--rule);border-radius:10.4px;background:var(--paper);color:var(--ink);font:400 0.875rem 'DM Sans',sans-serif}.ds-filter-control:hover{border-color:var(--ink-muted)}.ds-filter-control:focus-visible{border-color:var(--signal);outline:2px solid var(--signal);outline-offset:2px}"
    },
