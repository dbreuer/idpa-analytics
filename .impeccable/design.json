  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Square ink button for an emphasized action, with red hover and keyboard focus.",
      "html": "<button class=\"ds-primary-button\" type=\"button\">Open results</button>",
      "css": ".ds-primary-button{display:inline-flex;align-items:center;justify-content:center;padding:8px 16px;border:1px solid var(--ink);border-radius:0;background:var(--ink);color:var(--paper);font:600 0.875rem 'DM Sans',sans-serif;transition:background-color 150ms ease}.ds-primary-button:hover{background:var(--signal-dark)}.ds-primary-button:focus-visible{outline:2px solid var(--signal);outline-offset:3px}.ds-primary-button:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "Filter Select",
      "kind": "input",
      "refersTo": "filter-control",
      "description": "Labeled compact selector with warm paper fill and visible red focus.",
      "html": "<label class=\"ds-filter-label\" for=\"season-filter\">Division</label><select id=\"season-filter\" class=\"ds-filter-control\"><option>All divisions</option></select>",
      "css": ".ds-filter-label{display:block;color:var(--ink-muted);font:700 0.67rem 'DM Sans',sans-serif;letter-spacing:.14em;text-transform:uppercase}.ds-filter-control{display:block;width:100%;margin-top:6px;padding:8px 12px;border:1px solid var(--rule);border-radius:10.4px;background:var(--paper);color:var(--ink);font:400 0.875rem 'DM Sans',sans-serif}.ds-filter-control:hover{border-color:var(--ink-muted)}.ds-filter-control:focus-visible{border-color:var(--signal);outline:2px solid var(--signal);outline-offset:2px}"
    },
    {
      "name": "Section Navigation Link",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "An anchor to a semantic season-report section; current destination is underlined in red.",
      "html": "<a class=\"ds-section-link ds-section-link-active\" href=\"#rankings\" aria-current=\"location\">Rankings</a>",
      "css": ".ds-section-link{position:relative;display:inline-flex;min-height:2.75rem;align-items:center;padding:0 .55rem;color:var(--ink-muted);font:600 .79rem 'DM Sans',sans-serif;text-decoration:none;white-space:nowrap;transition:color 160ms ease}.ds-section-link:hover,.ds-section-link-active{color:var(--ink)}.ds-section-link-active:after{position:absolute;right:.55rem;bottom:.25rem;left:.55rem;height:2px;background:var(--signal);content:''}.ds-section-link:focus-visible{outline:2px solid var(--signal);outline-offset:3px}"
    },
    {
      "name": "Active Filter Count",
      "kind": "chip",
      "refersTo": "filter-count",
      "description": "A small red numeric count identifies active mobile filters.",
      "html": "<span class=\"ds-filter-count\" aria-label=\"2 active filters\">2</span>",
      "css": ".ds-filter-count{display:inline-flex;min-width:20px;min-height:20px;align-items:center;justify-content:center;padding:2px 6px;border-radius:2px;background:var(--signal);color:var(--paper);font:700 .75rem/1 'DM Sans',sans-serif;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Editorial Report Panel",
      "kind": "card",
      "refersTo": "report-card",
      "description": "Flat paper report field separated from neighboring content by an ink hairline.",
      "html": "<section class=\"ds-report-panel\"><h3>Season standings</h3><p>Official result totals.</p></section>",
      "css": ".ds-report-panel{min-width:0;padding:20px;border-top:1px solid var(--rule);background:var(--paper)}.ds-report-panel h3{margin:0;color:var(--ink);font:700 1.875rem/1 'Barlow Condensed',sans-serif}.ds-report-panel p{color:var(--ink-muted);font:400 .875rem/1.55 'DM Sans',sans-serif}"
    },
    {
      "name": "Ranking Scoreline",
      "kind": "custom",
      "refersTo": "report-card",
      "description": "A factual score and proportionally sized red hairline preserve rank readability without decorative imagery.",
      "html": "<div class=\"ds-scoreline\"><strong>01</strong><span>Competitor name</span><output>1131 points</output><span class=\"ds-score-track\"><i style=\"width:72%\"></i></span></div>",
      "css": ".ds-scoreline{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:12px;padding:16px;border-bottom:1px solid var(--rule);background:var(--paper-raised);color:var(--ink);font:600 .9rem 'DM Sans',sans-serif}.ds-scoreline strong{color:var(--signal);font:700 1.5rem 'Barlow Condensed',sans-serif}.ds-scoreline output{font-variant-numeric:tabular-nums}.ds-score-track{grid-column:1/-1;display:block;height:5px;background:var(--paper-deep)}.ds-score-track i{display:block;height:100%;background:var(--signal)}"
    },
    {
      "name": "Footer Discipline Link",
      "kind": "nav",
      "refersTo": "discipline-link",
      "description": "A real official federation page link with an unmodified mark and a visible discipline name.",
      "html": "<a class=\"ds-discipline-link\" href=\"https://mdlsz.com/idpa-szakag/\"><img alt=\"\" src=\"/logos/idpa-discipline.png\"><span>IDPA</span><span aria-hidden=\"true\">↗</span></a>",
      "css": ".ds-discipline-link{display:flex;min-width:0;min-height:4rem;align-items:center;gap:10px;padding:8px;border:1px solid rgb(250 249 245 / 20%);color:var(--paper);font:600 .76rem/1.25 'DM Sans',sans-serif;text-decoration:none;transition:border-color 150ms ease,background-color 150ms ease}.ds-discipline-link:hover{border-color:var(--footer-accent);background:rgb(250 249 245 / 5%)}.ds-discipline-link img{width:59px;height:42px;object-fit:contain;background:var(--paper-raised)}.ds-discipline-link:focus-visible{outline:2px solid var(--footer-accent);outline-offset:3px}"
    },
    {
      "name": "Steel Status Chip",
      "kind": "chip",
      "refersTo": "steel-status-chip",
      "description": "Route-scoped archive status and season context; green is reserved for available verified data.",
      "html": "<span class=\"ds-steel-status\"><i aria-hidden=\"true\"></i> MDLSZ / RESULTS ARCHIVE</span>",
      "css": ".ds-steel-status{display:inline-flex;min-height:28px;align-items:center;gap:7px;padding:6px 9px;border:1px solid #343c48;border-radius:4px;background:#181d24;color:#ff6b35;font:700 10px/1.2 ui-monospace,monospace;letter-spacing:.1em}.ds-steel-status i{width:7px;height:7px;border-radius:50%;background:#40b982}.ds-steel-status:hover{border-color:#ff6b35}.ds-steel-status:focus-visible{outline:2px solid #ff6b35;outline-offset:3px}"
    },
    {
      "name": "Steel Season Ledger",
      "kind": "custom",
      "refersTo": "steel-season-ledger",
      "description": "A ruled, factual season summary that moves from paired columns to a single handset list.",
      "html": "<dl class=\"ds-steel-ledger\"><div><dt>Ranked fields</dt><dd>—</dd></div><div><dt>Divisions</dt><dd>—</dd></div></dl>",
      "css": ".ds-steel-ledger{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px;border-top:1px solid #262d37}.ds-steel-ledger div{display:flex;min-height:52px;align-items:baseline;justify-content:space-between;gap:8px;padding:9px 2px;border-bottom:1px solid #262d37}.ds-steel-ledger dt{color:#9ba6b2;font:600 10px ui-monospace,monospace;letter-spacing:.07em;text-transform:uppercase}.ds-steel-ledger dd{margin:0;color:#f4f6f8;font:700 20px ui-monospace,monospace;font-variant-numeric:tabular-nums}@media(max-width:767px){.ds-steel-ledger{grid-template-columns:1fr}}"
    },
    {
      "name": "Steel Division Ranking Card",
      "kind": "card",
      "refersTo": "steel-division-card",
      "description": "A graphite division card with selectable, percentile-based rows and native field expansion.",
      "html": "<article class=\"ds-steel-card\"><h3>Division name</h3><button type=\"button\" class=\"ds-steel-rank\"><b>01</b><span>Competitor name</span><strong>Percentile</strong><i><em></em></i></button></article>",
      "css": ".ds-steel-card{padding:16px;border:1px solid #262d37;border-radius:5px;background:#1b2027;color:#f4f6f8}.ds-steel-card h3{margin:8px 0 12px;font:650 17px/1.35 'DM Sans',sans-serif}.ds-steel-rank{display:grid;width:100%;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:8px;padding:10px 3px;border:0;border-bottom:1px solid #262d37;background:transparent;color:#f4f6f8;text-align:left;font:600 13px 'DM Sans',sans-serif}.ds-steel-rank:hover,.ds-steel-rank[aria-pressed=true]{background:#222832}.ds-steel-rank:focus-visible{outline:2px solid #ff6b35;outline-offset:2px}.ds-steel-rank b,.ds-steel-rank strong{font:700 12px ui-monospace,monospace}.ds-steel-rank b{color:#ff6b35}.ds-steel-rank i{grid-column:1/-1;height:4px;background:#262d37}.ds-steel-rank em{display:block;width:70%;height:100%;background:#ff6b35}"
    },
    {
      "name": "Steel Result Table",
      "kind": "custom",
      "refersTo": "steel-record-table",
      "description": "A compact, ruled result ledger with secondary metadata and explicit source links.",
      "html": "<div class=\"ds-steel-table-wrap\"><table class=\"ds-steel-table\"><thead><tr><th>Event</th><th>Place</th><th>Field</th><th>Source</th></tr></thead><tbody><tr><td>Competition<span>date · level</span></td><td>—</td><td>—</td><td><a href=\"#source\">Official result</a></td></tr></tbody></table></div>",
      "css": ".ds-steel-table-wrap{overflow-x:auto;border:1px solid #262d37;border-radius:5px;background:#1b2027}.ds-steel-table{width:100%;min-width:600px;border-collapse:collapse;color:#f4f6f8;font:400 13px 'DM Sans',sans-serif}.ds-steel-table th,.ds-steel-table td{padding:12px 14px;border-bottom:1px solid #262d37;text-align:left;vertical-align:top}.ds-steel-table thead{background:#181d24;color:#9ba6b2;font:600 10px ui-monospace,monospace;letter-spacing:.07em;text-transform:uppercase}.ds-steel-table tbody tr:hover{background:#222832}.ds-steel-table td span{display:block;margin-top:4px;color:#9ba6b2;font-size:11px}.ds-steel-table a{color:#ff6b35;text-decoration:underline;text-underline-offset:3px}.ds-steel-table a:hover{color:#ff8a61}.ds-steel-table a:focus-visible{outline:2px solid #ff6b35;outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "The Championship Record",
    "overview": "Hero of IDPA reads each season as a traceable championship editorial record. A full-width season masthead, measured totals, open report grids, official links, and restrained data plots make rankings legible without presenting them as free-floating claims. The audience is competitors comparing a season of official Hungarian IDPA results.\n\nWarm opaque paper, championship ink, hairline rules, and a precise red signal form the page's reusable grammar. Display lettering carries the competition identity; ordinary interface work remains easy to read and operate. Section links, live season filters, year-specific routes, quality warnings, and official result sources are functional parts of the record.\n\nSteel Challenge carries a route-scoped telemetry treatment: graphite panels, orange active signals, restrained green availability, a ruled season ledger, division cards, and source-backed result tables. Other disciplines retain the warm editorial palette.",
    "keyCharacteristics": [
      "Full-bleed season masthead; centered editorial reading measure below.",
      "Opaque warm-paper surfaces and ruled, mostly square-corner reports.",
      "Championship red marks current state, standings, source links, and plot series.",
      "Reproducible season totals and rankings remain tied to official sources.",
      "Official organization marks retain their original artwork and attribution.",
      "Steel Challenge uses a route-scoped graphite telemetry variant; the warm editorial system remains the default for every other discipline."
    ],
    "rules": [
      {
        "name": "The Scoreline Rule",
        "body": "Red identifies an active navigation state, a source link, a ranking or a chart series. Keep it functional rather than using it to fill report surfaces decoratively.",
        "section": "colors"
      },
      {
        "name": "The Heading-First Rule",
        "body": "Let the semantic title lead. Reserve uppercase label styling for controls and actual data terms, not decorative text above card headings.",
        "section": "typography"
      },
      {
        "name": "The Rule-Over-Shadow Rule",
        "body": "Prefer a visible editorial rule or tonal paper shift to adding elevation.",
        "section": "elevation"
      },
      {
        "name": "The Route Scope Rule",
        "body": "Steel telemetry colors and treatments belong only to the Steel Challenge route. Do not promote its graphite surfaces or orange signal to the shared editorial palette.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep one URL and data set per published season; the selector lists available seasons only.",
      "Do retain source attribution, visible parsing/quality states, and semantic season-wide versus filtered scope.",
      "Do label and shape chart series with the existing palette, legible axes, and paper tooltips.",
      "Do retain official organization artwork without recoloring or distorting it; its source-to-link mapping lives in docs/asset-sources.md.",
      "Do maintain visible keyboard focus, a skip-to-content link, reduced-motion support, and a measured anchor offset.",
      "Do confine the Steel Challenge telemetry variant to its own route, keep orange functional and green status-only, and retain the warm editorial discipline palette elsewhere.",
      "Do keep Steel Challenge rankings tied to official placement percentiles and provide the source-backed season record; never infer unsupported performance measures from visual styling."
    ],
    "donts": [
      "Don't imply sponsorship or endorsement through organization or discipline marks.",
      "Don't use color as the only way to distinguish a ranking, state, or chart series.",
      "Don't make report cards compete with the actual season figures using glass, gradients, decorative shadow stacks, or ornamental accents.",
      "Don't apply Steel Challenge graphite, orange, or status-green tokens to other discipline routes by default.",
      "Don't imply stage records, raw stage timings, plate layouts, shooter ratings, or calculator results that the published data does not establish."
    ]
  }
}
