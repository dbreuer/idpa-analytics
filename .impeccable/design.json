      "html": "<a class=\"ds-section-link ds-section-link-active\" href=\"#rankings\" aria-current=\"location\">Rankings</a>",
      "css": ".ds-section-link{position:relative;display:inline-flex;min-height:2.75rem;align-items:center;padding:0 .55rem;color:var(--ink-muted);font:600 .79rem 'DM Sans',sans-serif;text-decoration:none;white-space:nowrap;transition:color 160ms ease}.ds-section-link:hover,.ds-section-link-active{color:var(--ink)}.ds-section-link-active:after{position:absolute;right:.55rem;bottom:.25rem;left:.55rem;height:2px;background:var(--signal);content:''}.ds-section-link:focus-visible{outline:2px solid var(--signal);outline-offset:3px}"
    },
